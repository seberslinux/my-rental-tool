{
  "name": "my-rental-tool",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "railway run concurrently --names backend,frontend --prefix-colors blue,green \"node --watch server.js\" \"cd client && npx vite\"",
    "dev:backend": "railway run node --watch server.js",
    "dev:client": "cd client && npx vite",
    "build": "cd client && npm install && npx vite build",
    "setup": "npm install && cd client && npm install && echo '\n--- Setup complete! Run: npm run dev ---'",
    "postinstall": "cd client && npm install",
    "test": "node --test 'test/*.test.js' && node --test --test-concurrency=1 'test/integration/**/*.test.js'",
    "test:unit": "node --test 'test/*.test.js'",
    "test:integration": "node --test --test-concurrency=1 'test/integration/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout 'test/**/*.test.js'",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "local:db": "docker compose -f docker-compose.local.yml up -d",
    "local:seed": "DATABASE_URL=postgres://postgres:postgres@localhost:5434/rental_local SESSION_SECRET=local-dev-secret node scripts/seed-local.js",
    "local:reset": "docker compose -f docker-compose.local.yml down -v && npm run local:db && sleep 3 && npm run local:seed",
    "local": "npm run local:db && sleep 2 && npm run local:seed && npm run build && DATABASE_URL=postgres://postgres:postgres@localhost:5434/rental_local SESSION_SECRET=local-dev-secret node --watch server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.19.0",
    "node-cron": "^4.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "supertest": "^7.2.2"
  }
}
