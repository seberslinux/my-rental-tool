SMOOBU_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
CHECKIN_MESSAGE_TEMPLATE=Dear guest, we look forward to welcoming you tomorrow. Here are your check-in details: ...
CHECKOUT_MESSAGE_TEMPLATE=Dear guest, just a reminder that checkout is at 10am today. Thank you for staying with us!
