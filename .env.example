SMOOBU_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
CHECKIN_MESSAGE_TEMPLATE=Dear guest, we look forward to welcoming you tomorrow. Here are your check-in details: ...
CHECKOUT_MESSAGE_TEMPLATE=Dear guest, just a reminder that checkout is at 10am today. Thank you for staying with us!
PORT=3000

# Direct bookings: each property's Paystack key is entered in the app
# (More → Direct bookings → Paystack accounts), not here.
# Optional: the guests' booking address, e.g. https://book.example.com — booking
# pages, payment links and Paystack callbacks use it, and only those are served
# there (the app stays on APP_URL). Its bare address redirects to WEBSITE_URL.
PUBLIC_BASE_URL=
WEBSITE_URL=
# Optional: Smoobu "Direct booking" channel id (found automatically otherwise)
SMOOBU_DIRECT_CHANNEL_ID=

# Claude (MCP server at <APP_URL>/mcp): addresses allowed to receive a sign-in.
# Default: claude.ai, claude.com and this computer (Claude Code, desktop).
MCP_REDIRECT_HOSTS=
